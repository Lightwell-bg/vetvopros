# Copy to .env and fill in values. Never commit .env.
# Загрузка: сначала .env в корне репозитория (рядом с config.ini), затем .env из текущего каталога.

# PostgreSQL (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/vetvopros

# Опционально: явный путь к config.ini
# VETVOPROS_CONFIG_INI=

# Бот: принудительно включить/выключить автоприменение Alembic при отсутствии таблиц
# (если не задано: при environment=development в config.ini — миграции применяются сами)
# VETVOPROS_AUTO_MIGRATE=true

# Автосоздание БД из DATABASE_URL, если БД ещё нет
# (если не задано: в development включено автоматически)
# VETVOPROS_AUTO_CREATE_DB=true

# Админка (uvicorn через src/run_admin.py)
# VETVOPROS_ADMIN_HOST=0.0.0.0
# VETVOPROS_ADMIN_PORT=8000
# VETVOPROS_ADMIN_RELOAD=false

# Telegram (токен от @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# LLM / embeddings (OpenAI-compatible)
LLM_API_KEY=your-llm-api-key
# Optional: custom base URL for compatible APIs
LLM_BASE_URL=

# Admin panel (обязательны для python src/run_admin.py)
# Секрет подписи cookie сессии — длинная случайная строка, не оставляйте пример ниже в проде.
ADMIN_SESSION_SECRET=change-me-to-random-long-string
# Логин и пароль для формы входа (хранятся в .env в открытом виде — для production используйте HTTPS и ограничение доступа по сети)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Payment stub / future provider
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=
