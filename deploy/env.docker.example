# Шаблон .env для Docker Compose (VetVopros).
# Скопируйте в .env и заполните значения.

# PostgreSQL
POSTGRES_USER=vetvopros
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=vetvopros

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# LLM / embeddings
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=

# Admin panel
ADMIN_SESSION_SECRET=change-me-to-random-long-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Порт админки на хосте (внутри контейнера всегда 8000)
ADMIN_HOST_PORT=8000

# Payment stub
PAYMENT_PROVIDER=stub
PAYMENT_WEBHOOK_SECRET=
